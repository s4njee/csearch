# Copy to /etc/senate-vote-cache.env on the RPi and `chmod 600` it.
# Required: a GitHub fine-grained PAT scoped to this repo with
#   Repository permissions → Contents: Read and write
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Keep this aligned with the systemd unit's StateDirectory / ProtectHome settings.
WORK_DIR=/var/lib/senate-vote-cache

# Optional overrides (defaults shown):
# REPO_URL=https://github.com/s4njee/csearch.git
# SCRAPER_REF=main
# CONGRESS=119
# FORCE=1            # 1 = re-download all each run (CI parity); 0 = incremental (gentler on senate.gov)
